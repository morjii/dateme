{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "cancelled",
        "refunded"
      ]
    },
    "email": {
      "type": "email",
      "required": true
    },
    "items": {
      "type": "component",
      "component": "order.order-order-item",
      "repeatable": true,
      "required": true
    },
    "subtotal": {
      "type": "integer",
      "required": true
    },
    "discount": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "shippingFee": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "total": {
      "type": "integer",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "stripeCheckoutSessionId": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "stripePaymentIntentId": {
      "type": "string",
      "unique": true
    },
    "shippingAddress": {
      "type": "component",
      "component": "shared.shared-address",
      "repeatable": false
    }
  }
}
